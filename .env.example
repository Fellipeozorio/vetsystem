# Exemplo de .env para o projeto VetSystem
# Copie este arquivo para .env e preencha com valores reais (NÃO comitar o .env)

# Django
SECRET_KEY=changeme_generate_a_secure_secret_key
DEBUG=True

# Database (exemplo PostgreSQL) - ajuste conforme seu ambiente
# Ex: postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Email (opcional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@vetsystem.com

# Optional: superuser creation used by deployment scripts
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=changeme

# Dicas:
# - Nunca comite seu .env real.
# - Se chaves foram comprometidas, rotacione-as imediatamente.
# - Mantenha este arquivo como documentação das variáveis necessárias.
